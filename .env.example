# Copia este archivo como ".env" (sin el ".example") y completa tus valores reales.
# El archivo ".env" NUNCA se sube a GitHub (ya está en .gitignore).

# Puerto donde corre el servidor Express (opcional, por defecto usa 4000)
PORT=4000

# Cadena de conexión a MongoDB (Atlas o local)
# Ejemplo Atlas: mongodb+srv://usuario:password@cluster.mongodb.net/contactos
# Ejemplo local: mongodb://127.0.0.1:27017/contactos
MONGO_URI=
